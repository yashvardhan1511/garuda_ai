# GARUDA AI backend configuration
# Create a Groq API key and paste it below. Never commit your real .env file.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Security: replace this before any public deployment
SECRET_KEY=replace_with_a_long_random_secret

# Docker Compose supplies DATABASE_URL and Redis URLs automatically.
# For a separate backend process, set DATABASE_URL to a PostgreSQL URL.
# DATABASE_URL=postgresql://garuda:change_this_password@localhost:5432/garuda
# CORS_ORIGINS=http://localhost:5173
# NTFY_TOPIC=garuda_ai_alerts
